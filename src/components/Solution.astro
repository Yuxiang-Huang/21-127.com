---
import { SignInButton } from "@clerk/astro/components";

interface Props {
	id: string;
	label?: "Solution" | "Proof";
}

const { id, label = "Solution" } = Astro.props;
const prompt =
	label === "Proof"
		? "Sign in to view the proof"
		: "Sign in to view the solution";
---

<div class="solution" data-gated={id}>
	<SignInButton mode="modal">{prompt}</SignInButton>
</div>

<script>
import { loadGated, revealSolutions } from "../lib/client/gated";
import { onSession } from "../lib/client/session";

onSession((user) => {
	if (!user) return;
	void loadGated().then((payload) => {
		if (payload) revealSolutions(payload.solutions);
	});
});
</script>
