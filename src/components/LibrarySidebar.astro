---
import ListChecks from "@lucide/astro/icons/list-checks";
import {
	entryPath,
	type Kind,
	recallEntries,
	type Subtopic,
	type Topic,
} from "../lib/library/load";
import KindIcon from "./KindIcon.astro";

interface Props {
	topic: Topic;
	subtopic: Subtopic;
	currentKind?: Kind;
	currentSlug?: string;
	quiz?: "subtopic" | "topic";
}

const { topic, subtopic, currentKind, currentSlug, quiz } = Astro.props;

function here(item: Subtopic, kind: Kind, slug?: string) {
	return (
		item.slug === subtopic.slug &&
		currentKind === kind &&
		(slug === undefined || currentSlug === slug)
	);
}
---

<aside class="sidebar">
	<p class="topic-name">{topic.title}</p>
	<ul class="subtopics">
		{topic.subtopics.map((item) =>
			item.slug === "quiz" ? (
				<li class:list={{ current: quiz === "topic" }}>
					<a class="quiz-link" href={`/${topic.slug}/quiz`}>
						<ListChecks size={16} aria-hidden="true" />
						<span>Quiz</span>
					</a>
				</li>
			) : (
				<li>
					<details open={item.slug === subtopic.slug}>
						<summary>{item.title}</summary>
						<ul>
							{item.kinds.definitions.length > 0 && (
								<li class:list={{ current: here(item, "definitions") }}>
									<a href={`/${topic.slug}/${item.slug}/definitions`}>
										<KindIcon kind="definitions" />
										<span>Definitions</span>
									</a>
								</li>
							)}
							{item.kinds.techniques.length > 0 && (
								<li class:list={{ current: here(item, "techniques") }}>
									<a href={`/${topic.slug}/${item.slug}/techniques`}>
										<KindIcon kind="techniques" />
										<span>Techniques</span>
									</a>
								</li>
							)}
							{item.kinds.theorems.length > 0 && (
								<li class:list={{ current: here(item, "theorems") }}>
									<a href={`/${topic.slug}/${item.slug}/theorems`}>
										<KindIcon kind="theorems" />
										<span>Theorems</span>
									</a>
								</li>
							)}
							{recallEntries(item).length > 0 && (
								<li
									class:list={{
										current: quiz === "subtopic" && item.slug === subtopic.slug,
									}}
								>
									<a href={`/${topic.slug}/${item.slug}/quiz`}>
										<ListChecks size={16} aria-hidden="true" />
										<span>Quiz</span>
									</a>
								</li>
							)}
							{item.kinds.problems.map((entry) => (
								<li
									class:list={{
										current: here(item, "problems", entry.slug),
									}}
								>
									<a href={entryPath(entry)}>
										<KindIcon kind="problems" />
										<span>{entry.title}</span>
									</a>
								</li>
							))}
						</ul>
					</details>
				</li>
			),
		)}
	</ul>
</aside>
