---
import { Show } from "@clerk/astro/components";
import Layout from "../layouts/Layout.astro";
import { getInterestCount, hasInterest } from "../lib/interest";
import { catalog, entryPath, firstEntry } from "../lib/library/load";
import "../styles/library.css";

const { isAuthenticated, userId } = Astro.locals.auth();
const count = await getInterestCount();
const interested =
	isAuthenticated && userId ? await hasInterest(userId) : false;
const countLabel =
	count === 1 ? "1 person is interested" : `${count} people are interested`;
---

<Layout title="21-127">
	<div class="library home">
		<div class="cards">
			{
				catalog.topics.map((topic) => (
					<article class="card">
						<h2>{topic.title}</h2>
						<ul>
							{topic.subtopics.map((subtopic) => (
								<li>
									<a href={entryPath(firstEntry(subtopic))}>{subtopic.title}</a>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
		<section class="interest">
			<h2>21-127: Concepts of Mathematics</h2>
			<p class="lede">
				Express your interest in additional resources for CMU's 21-127: Concepts
				of Mathematics course!
			</p>
			<p class="count" aria-live="polite">{countLabel}</p>
			<Show when="signed-in">
				<div class="actions">
					<form method="post" action="/api/interest">
						<button type="submit">
							{interested ? "I'm no longer interested" : "I'm interested"}
						</button>
					</form>
				</div>
			</Show>
		</section>
	</div>
</Layout>
