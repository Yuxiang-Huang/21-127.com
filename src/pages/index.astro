---
import source from "../../21-127.com-data/introduction.tex?raw";
import Layout from "../layouts/Layout.astro";
import { catalog, subtopicPath } from "../lib/library/load";
import { renderTex } from "../lib/library/render";
import "../styles/library.css";

export const prerender = true;

const introduction = renderTex(source, "introduction.tex");
---

<Layout title="21-127">
	<div class="library home">
		<h1>21-127: Concepts of Mathematics</h1>
		<div class="cards">
			<article class="card">
				<h2>Introduction</h2>
				<ul>
					<li>
						<a href="/introduction">{introduction.title}</a>
					</li>
				</ul>
			</article>
			{catalog.topics.map((topic) => (
				<article class="card">
					<h2>{topic.title}</h2>
					<ul>
						{topic.subtopics.map((subtopic) => (
							<li>
								<a href={subtopicPath(topic.slug, subtopic)}>
									{subtopic.title}
								</a>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
		<section class="interest">
			<p class="lede">
				Express your interest in additional resources for CMU's 21-127: Concepts
				of Mathematics course!
			</p>
			<p class="count" data-interest-count aria-live="polite"></p>
			<div class="actions" data-interest-actions hidden>
				<form method="post" action="/api/interest">
					<button type="submit" data-interest-button>I'm interested</button>
				</form>
			</div>
		</section>
	</div>
</Layout>

<script>
import { onSession } from "../lib/client/session";

const countEl = document.querySelector("[data-interest-count]");
const actions = document.querySelector("[data-interest-actions]");
const button = document.querySelector("[data-interest-button]");

async function paint() {
	const response = await fetch("/api/interest");
	if (!response.ok) return;
	const body = (await response.json()) as {
		count?: number;
		signedIn?: boolean;
		interested?: boolean;
	};
	if (typeof body.count !== "number" || !(countEl instanceof HTMLElement))
		return;
	countEl.textContent =
		body.count === 1
			? "1 person is interested"
			: `${body.count} people are interested`;
	if (
		!(actions instanceof HTMLElement) ||
		!(button instanceof HTMLButtonElement)
	) {
		return;
	}
	actions.hidden = !body.signedIn;
	if (body.signedIn) {
		button.textContent = body.interested
			? "I'm no longer interested"
			: "I'm interested";
	}
}

void paint();
onSession((user) => {
	if (user) void paint();
});
</script>
