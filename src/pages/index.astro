---
import { Show } from "@clerk/astro/components";
import Layout from "../layouts/Layout.astro";
import { getInterestCount, hasInterest } from "../lib/interest";
import source from "../../21-127.com-data/introduction.tex?raw";
import { catalog, subtopicPath } from "../lib/library/load";
import { renderTex } from "../lib/library/render";
import "../styles/library.css";

const introduction = renderTex(source, "introduction.tex");

const { isAuthenticated, userId } = Astro.locals.auth();
const count = await getInterestCount();
const interested =
	isAuthenticated && userId ? await hasInterest(userId) : false;
const countLabel =
	count === 1 ? "1 person is interested" : `${count} people are interested`;
const upcoming = ["Logics", "Sets", "Inductions"];
---

<Layout title="21-127">
	<div class="library home">
		<h1>21-127: Concepts of Mathematics</h1>
		<div class="cards">
			<article class="card">
				<h2>Introduction</h2>
				<ul>
					<li>
						<a href="/introduction">{introduction.title}</a>
					</li>
				</ul>
			</article>
			{
				upcoming.map((title) => (
					<article class="card">
						<h2>{title}</h2>
						<p class="coming">Coming on Fall Break</p>
					</article>
				))
			}
			{
				catalog.topics.map((topic) => (
					<article class="card">
						<h2>{topic.title}</h2>
						<ul>
							{topic.subtopics.map((subtopic) => (
								<li>
									<a href={subtopicPath(subtopic)}>{subtopic.title}</a>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
		<section class="interest">
			<p class="lede">
				Express your interest in additional resources for CMU's 21-127: Concepts
				of Mathematics course!
			</p>
			<p class="count" aria-live="polite">{countLabel}</p>
			<Show when="signed-in">
				<div class="actions">
					<form method="post" action="/api/interest">
						<button type="submit">
							{interested ? "I'm no longer interested" : "I'm interested"}
						</button>
					</form>
				</div>
			</Show>
		</section>
	</div>
</Layout>
