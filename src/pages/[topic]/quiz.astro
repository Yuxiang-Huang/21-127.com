---
import "katex/dist/katex.min.css";
import LibrarySidebar from "../../components/LibrarySidebar.astro";
import Recall from "../../components/Recall.astro";
import Layout from "../../layouts/Layout.astro";
import { topicQuizPaths } from "../../lib/library/gated";
import { catalog, getSubtopic } from "../../lib/library/load";
import "../../styles/library.css";

export const prerender = true;

export function getStaticPaths() {
	return topicQuizPaths();
}

const topicSlug = Astro.params.topic;
const found = topicSlug ? getSubtopic(catalog, topicSlug, "quiz") : undefined;
if (!found) throw new Error(`missing topic quiz ${topicSlug}`);
const { topic, subtopic } = found;
---

<Layout title={`${topic.title} quiz · 21-127`}>
	<div class="library reading">
		<LibrarySidebar topic={topic} subtopic={subtopic} quiz="topic" />
		<article class="article">
			<Recall heading={`${topic.title} quiz`} />
		</article>
	</div>
</Layout>
