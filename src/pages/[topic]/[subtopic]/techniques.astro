---
import "katex/dist/katex.min.css";
import LibrarySidebar from "../../../components/LibrarySidebar.astro";
import Solution from "../../../components/Solution.astro";
import Layout from "../../../layouts/Layout.astro";
import { catalog, getSubtopic } from "../../../lib/library/load";
import "../../../styles/library.css";

const topicSlug = Astro.params.topic;
const subtopicSlug = Astro.params.subtopic;
const found =
	topicSlug && subtopicSlug
		? getSubtopic(catalog, topicSlug, subtopicSlug)
		: undefined;
const techniques = found?.subtopic.kinds.techniques ?? [];

if (!found || techniques.length === 0) {
	Astro.response.status = 404;
}

const topic = found?.topic;
const subtopic = found?.subtopic;
---

<Layout
	title={subtopic ? `Techniques · ${subtopic.title} · 21-127` : "Not found"}
>
	{topic && subtopic && techniques.length > 0 ? (
		<div class="library reading">
			<LibrarySidebar
				topic={topic}
				subtopic={subtopic}
				currentKind="techniques"
			/>
			<article class="article">
				<h1>Techniques</h1>
				{subtopic.leads.techniques && (
					<div class="prose kind-lead" set:html={subtopic.leads.techniques} />
				)}
				{techniques.map((entry) => (
					<section class="definition" id={entry.slug}>
						<h2>{entry.title}</h2>
						<div class="prose" set:html={entry.html} />
						<Solution html={entry.solutionHtml} />
					</section>
				))}
			</article>
		</div>
	) : (
		<p class="missing">Not found.</p>
	)}
</Layout>

<script>
import "katex/contrib/copy-tex";
</script>
