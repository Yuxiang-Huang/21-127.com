---
import "katex/dist/katex.min.css";
import LibrarySidebar from "../../../components/LibrarySidebar.astro";
import Solution from "../../../components/Solution.astro";
import Layout from "../../../layouts/Layout.astro";
import { kindPaths } from "../../../lib/library/gated";
import { catalog, getSubtopic } from "../../../lib/library/load";
import "../../../styles/library.css";

export const prerender = true;

export function getStaticPaths() {
	return kindPaths("theorems");
}

const topicSlug = Astro.params.topic;
const subtopicSlug = Astro.params.subtopic;
const found =
	topicSlug && subtopicSlug
		? getSubtopic(catalog, topicSlug, subtopicSlug)
		: undefined;
if (!found || found.subtopic.kinds.theorems.length === 0) {
	throw new Error(`missing theorems page ${topicSlug}/${subtopicSlug}`);
}
const { topic, subtopic } = found;
const theorems = subtopic.kinds.theorems;
---

<Layout title={`Theorems · ${subtopic.title} · 21-127`}>
	<div class="library reading">
		<LibrarySidebar topic={topic} subtopic={subtopic} currentKind="theorems" />
		<article class="article">
			<h1>Theorems</h1>
			{theorems.map((entry) => (
				<section class="definition" id={entry.slug}>
					<h2>{entry.title}</h2>
					<div class="prose" set:html={entry.html} />
					{entry.proofHtml ? <Solution id={entry.slug} label="Proof" /> : null}
				</section>
			))}
		</article>
	</div>
</Layout>

<script>
import "katex/contrib/copy-tex";
</script>
