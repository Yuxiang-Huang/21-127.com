---
import "katex/dist/katex.min.css";
import LibrarySidebar from "../../../components/LibrarySidebar.astro";
import Layout from "../../../layouts/Layout.astro";
import { catalog, getSubtopic } from "../../../lib/library/load";
import "../../../styles/library.css";

const topicSlug = Astro.params.topic;
const subtopicSlug = Astro.params.subtopic;
const found =
	topicSlug && subtopicSlug
		? getSubtopic(catalog, topicSlug, subtopicSlug)
		: undefined;
const definitions = found?.subtopic.kinds.definitions ?? [];

if (!found || definitions.length === 0) {
	Astro.response.status = 404;
}

const topic = found?.topic;
const subtopic = found?.subtopic;
---

<Layout title={subtopic ? `${subtopic.title} · 21-127` : "Not found"}>
	{
		topic && subtopic && definitions.length > 0 ? (
			<div class="library reading">
				<LibrarySidebar
					topic={topic}
					subtopic={subtopic}
					currentKind="definitions"
				/>
				<article class="article">
					<h1>{subtopic.title}</h1>
					{definitions.map((entry) => (
						<section class="definition" id={entry.slug}>
							<h2>{entry.title}</h2>
							<div class="prose" set:html={entry.html} />
							{entry.solutionHtml && (
								<details class="solution">
									<summary>Solution</summary>
									<div class="prose" set:html={entry.solutionHtml} />
								</details>
							)}
						</section>
					))}
				</article>
			</div>
		) : (
			<p class="missing">Not found.</p>
		)
	}
</Layout>

<script>
	import "katex/contrib/copy-tex";
</script>
