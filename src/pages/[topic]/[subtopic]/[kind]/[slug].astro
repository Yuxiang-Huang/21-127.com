---
import "katex/dist/katex.min.css";
import LibrarySidebar from "../../../../components/LibrarySidebar.astro";
import Solution from "../../../../components/Solution.astro";
import Layout from "../../../../layouts/Layout.astro";
import { catalog, entryPath, getEntry } from "../../../../lib/library/load";
import "../../../../styles/library.css";

const topicSlug = Astro.params.topic;
const subtopicSlug = Astro.params.subtopic;
const kind = Astro.params.kind;
const slug = Astro.params.slug;
const found =
	topicSlug && subtopicSlug && kind && slug
		? getEntry(catalog, topicSlug, subtopicSlug, kind, slug)
		: undefined;

if (
	found?.entry.kind === "definitions" ||
	found?.entry.kind === "techniques" ||
	found?.entry.kind === "theorems"
) {
	return Astro.redirect(entryPath(found.entry), 301);
}

if (!found) {
	Astro.response.status = 404;
}

const topic = found?.topic;
const subtopic = found?.subtopic;
const entry = found?.entry;
---

<Layout title={entry ? `${entry.title} · 21-127` : "Not found"}>
	{entry && topic && subtopic ? (
		<div class="library reading">
			<LibrarySidebar
				topic={topic}
				subtopic={subtopic}
				currentKind={entry.kind}
				currentSlug={entry.slug}
			/>
			<article class="article">
				<h1>{entry.title}</h1>
				{entry.inlineProblems ? (
					<div class="prose">
						<div set:html={entry.html} />
						<ol>
							{entry.inlineProblems.map((item) => (
								<li>
									<div set:html={item.promptHtml} />
									<Solution html={item.solutionHtml} />
								</li>
							))}
						</ol>
					</div>
				) : (
					<>
						<div class="prose" set:html={entry.html} />
						<Solution html={entry.solutionHtml} />
					</>
				)}
			</article>
		</div>
	) : (
		<p class="missing">Not found.</p>
	)}
</Layout>

<script>
import "katex/contrib/copy-tex";
</script>
