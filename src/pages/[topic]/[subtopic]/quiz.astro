---
import "katex/dist/katex.min.css";
import LibrarySidebar from "../../../components/LibrarySidebar.astro";
import Recall from "../../../components/Recall.astro";
import Layout from "../../../layouts/Layout.astro";
import { subtopicQuizPaths } from "../../../lib/library/gated";
import { catalog, getSubtopic } from "../../../lib/library/load";
import "../../../styles/library.css";

export const prerender = true;

export function getStaticPaths() {
	return subtopicQuizPaths();
}

const topicSlug = Astro.params.topic;
const subtopicSlug = Astro.params.subtopic;
const found =
	topicSlug && subtopicSlug
		? getSubtopic(catalog, topicSlug, subtopicSlug)
		: undefined;
if (!found || found.subtopic.slug === "quiz") {
	throw new Error(`missing quiz ${topicSlug}/${subtopicSlug}`);
}
const { topic, subtopic } = found;
---

<Layout title={`${subtopic.title} quiz · 21-127`}>
	<div class="library reading">
		<LibrarySidebar topic={topic} subtopic={subtopic} quiz="subtopic" />
		<article class="article">
			<Recall heading={`${subtopic.title} quiz`} />
		</article>
	</div>
</Layout>
