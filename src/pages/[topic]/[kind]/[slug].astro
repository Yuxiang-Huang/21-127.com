---
import Layout from "../../../layouts/Layout.astro";
import { catalog, entryPath, findEntry } from "../../../lib/library/load";
import "../../../styles/library.css";

const topicSlug = Astro.params.topic;
const kind = Astro.params.kind;
const slug = Astro.params.slug;
const entry =
	topicSlug && kind && slug
		? findEntry(catalog, topicSlug, kind, slug)
		: undefined;

if (entry) {
	return Astro.redirect(entryPath(entry), 301);
}

Astro.response.status = 404;
---

<Layout title="Not found">
	<p class="missing">Not found.</p>
</Layout>
