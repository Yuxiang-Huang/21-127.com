{
	"name": "21-127-com",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev",
		"astro": "astro",
		"deploy": "astro build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply 21-127 --local",
		"db:migrate": "wrangler d1 migrations apply 21-127 --remote",
		"db:export": "bash scripts/export-d1.sh",
		"setup": "bash scripts/setup.sh",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "biome check . && astro check",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.0",
		"@clerk/astro": "^4.1.0",
		"@lucide/astro": "^1.51.0",
		"astro": "^7.3.1",
		"drizzle-orm": "^0.45.2",
		"katex": "^0.19.0",
		"yaml": "^2.9.1"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/katex": "^0.16.8",
		"husky": "^9.1.7",
		"typescript": "6",
		"wrangler": "^4.129.0"
	}
}
